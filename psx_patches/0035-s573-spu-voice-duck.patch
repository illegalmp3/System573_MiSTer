       dbg573_mdecmb         : out    std_logic := '0';   -- toggles once per decoded macroblock
       mdec15Fast            : in     std_logic := '0';   -- see mdec.vhd (psx_patches 0030)
-      dbg573_pc             : out    std_logic_vector(31 downto 0) := (others => '0')  -- fetch PC (psx_patches 0031)
+      dbg573_pc             : out    std_logic_vector(31 downto 0) := (others => '0');  -- fetch PC (psx_patches 0031)
+      -- psx_patches 0035: SPU register writes out (observation), per-voice duck in
+      s573_spu_we           : out    std_logic := '0';
+      s573_spu_addr         : out    std_logic_vector(9 downto 0) := (others => '0');
+      s573_spu_din          : out    std_logic_vector(15 downto 0) := (others => '0');
+      s573_duck             : in     std_logic_vector(23 downto 0) := (others => '0');
+      s573_duck_mode        : in     std_logic_vector(1 downto 0) := "00"
    );
 end entity;
 
@@ -1795,9 +1801,16 @@
       SS_RAM_request       => SS_SPURAM_request,  
       SS_RAM_rnw           => SS_SPURAM_rnw,      
       SS_RAM_dataRead      => SS_SPURAM_dataRead, 
-      SS_RAM_done          => SS_SPURAM_done     
+      SS_RAM_done          => SS_SPURAM_done,
+      s573_duck            => s573_duck,
+      s573_duck_mode       => s573_duck_mode
    );
    
+   -- psx_patches 0035: the SPU's register-write port, observed (nothing reads back).
+   s573_spu_we   <= bus_spu_write;
+   s573_spu_addr <= std_logic_vector(bus_spu_addr);
+   s573_spu_din  <= bus_spu_dataWrite;
+   
    iexp2 : entity work.exp2
    port map
    (
