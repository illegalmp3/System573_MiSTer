 end entity;
 
@@ -705,7 +707,9 @@
       dbg573_cpupaused      => dbg573_cpupaused,
       dbg573_cpustall       => dbg573_cpustall,
       dbg573_gpubusy        => dbg573_gpubusy,
-      dbg573_mdecbusy       => dbg573_mdecbusy
