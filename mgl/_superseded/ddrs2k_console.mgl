<!--
  ddrs2k (DDR Solo 2000, GC905 VER. JAA) -- PLAY launcher. Loads the GAME cassette (gc905ja.u1 + gc905aa.u6). Boots from the flash restored out of ddrs2k.sav.

  Six items max: Main parses at most SIX file/reset items per .mgl and silently drops
  the rest (mra_loader.h mgl_item_struct item[6]).

  OSD for this title: 573 Cabinet = DDR Solo; 573 MP3 Descramble = DEFAULT (this is
  NOT the Solo Bass Mix scheme -- the MAME config for ddrs2k has no set_ddrsbm_fpga);
  573 Boot Device = CD-ROM to install, Flash ROM afterwards.

  Paths are bare filenames: resolved games-folder-relative across storages, so they
  work with games on USB. The save file MUST exist before launch -- Main does not
  auto-create it on this path (pre=0), it ejects the slot (docs/2026-09-12-flash-
  persistence-fixed.md).
-->
<mistergamedescription>
  <rbf>_Console/Konami_System_573</rbf>
  <setname>System573</setname>
  <!-- the .sav FIRST: docs/2026-09-29-sav-mount-order.md (a slot-4 mount after the downloads let the previous title's .sav seed this title's flash) -->
  <file delay="1" type="s" index="4" path="ddrs2k.sav"/>
  <file delay="1" type="f" index="0" path="573bios.bin"/>
  <file delay="1" type="f" index="4" path="ddrs2k.u1"/>
  <file delay="1" type="f" index="5" path="ddrs2k.u6"/>
  <file delay="2" type="s" index="1" path="ddrs2k.chd"/>
  <reset delay="1"/>
</mistergamedescription>
